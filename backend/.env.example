# Credenciais da API do Google Gemini.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Banco de dados Supabase (PostgreSQL e pgvector).
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_KEY=""

# Configurações do servidor local.
APP_ENV="development"
APP_PORT=8000
APP_HOST="127.0.0.1"

# Diretórios locais para armazenamento temporário.
DATA_DIR="./data"
UPLOADS_DIR="./data/uploads"
CHROMA_PERSIST_DIR="./data/vector_db"
