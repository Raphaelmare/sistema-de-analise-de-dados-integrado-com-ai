# Ambientes Virtuais Python
backend/venv/
venv/
env/
ENV/

# Credenciais e Variaveis de Ambiente (Critico: NUNCA versionar)
backend/.env
.env
*.env.local
.env.*
!.env.example
backend/.env.*
